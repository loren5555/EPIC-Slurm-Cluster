---
dashboard_title: "EPIC"

# Keep every EPIC-managed application visible on the landing page. The same
# inventory list also controls publication into the system application catalog.
pinned_apps:
{% for application in ood_dashboard_pinned_apps %}
  - "{{ application }}"
{% endfor %}
pinned_apps_menu_length: {{ ood_dashboard_pinned_apps | length }}

dashboard_layout:
  rows:
    - columns:
        - width: 12
          widgets:
            - pinned_apps
            - sessions
            - motd
    - columns:
        - width: 12
          widgets:
            - epic_disk_quota_status

remote_files_enabled: true
remote_files_validation: false
files_enable_shell_button: false
bc_dynamic_js: true
bc_clean_old_dirs: true
bc_clean_old_dirs_days: {{ ood_session_retention_days }}
cancel_session_enabled: true
upload_enabled: true
download_enabled: true
