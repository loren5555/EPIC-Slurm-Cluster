{
  "annotations": {"list": []},
  "description": "Practical EPIC cluster overview combining current status, recent scheduling, resource use, and accounting summaries.",
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {"asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Cluster Administration", "type": "link", "url": "/d/epic-cluster-administration"},
    {"asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Cluster Availability", "type": "link", "url": "/d/epic-cluster-availability"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Current responding targets across Grafana, Prometheus, exporters, and Slurm endpoints.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(up)", "instant": true, "refId": "A"}],
      "title": "Healthy Targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Current Slurm running jobs.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "slurm_jobs_running", "instant": true, "refId": "A"}],
      "title": "Running Jobs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Current pending Slurm jobs, including held jobs.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "slurm_jobs_pending", "instant": true, "refId": "A"}],
      "title": "Pending Jobs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Configured GPUs that are not allocated by Slurm.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(epic_slurm_node_gpus_available)", "instant": true, "refId": "A"}],
      "title": "Available GPUs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "GPU card-hours accumulated in the current calendar month.",
      "fieldConfig": {"defaults": {"unit": "h"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(epic_slurm_gpu_allocated_seconds) / 3600", "instant": true, "refId": "A"}],
      "title": "Current-month GPU Hours",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Age of the last successful slow accounting report.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "time() - epic_slurm_accounting_collector_last_success_unixtime", "instant": true, "refId": "A"}],
      "title": "Accounting Data Age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Running and pending job trends from Slurm native OpenMetrics.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "slurm_jobs_running", "legendFormat": "running", "refId": "A"},
        {"expr": "slurm_jobs_pending", "legendFormat": "pending", "refId": "B"}
      ],
      "title": "Job Queue",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Immediate Slurm GPU allocation by node. SSH workloads on free hosts are intentionally not counted.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "epic_slurm_node_gpus_allocated", "legendFormat": "{{node}} allocated", "refId": "A"},
        {"expr": "epic_slurm_node_gpus_available", "legendFormat": "{{node}} available", "refId": "B"}
      ],
      "title": "Slurm GPU Allocation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Average non-idle CPU utilization by host.",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Host CPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Available memory by host.",
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "node_memory_MemAvailable_bytes", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Host Available Memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "GPU activity observed by DCGM. Use the upstream GPU dashboards for detailed diagnosis.",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "{{instance}} GPU {{gpu}}", "refId": "A"}],
      "title": "GPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "GPU thermal summary across compute nodes.",
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "{{instance}} GPU {{gpu}}", "refId": "A"}],
      "title": "GPU Temperature",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Current calendar-month GPU usage by Account.",
      "fieldConfig": {"defaults": {"unit": "h"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 29},
      "id": 13,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true},
      "targets": [{"expr": "sum by (account) (epic_slurm_gpu_allocated_seconds) / 3600", "instant": true, "legendFormat": "{{account}}", "refId": "A"}],
      "title": "Current-month GPU Hours by Account",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Current pending jobs and their scheduler reasons.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 29},
      "id": 14,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"expr": "sum by (partition, reason) (epic_slurm_pending_jobs)", "format": "table", "instant": true, "refId": "A"}],
      "title": "Current Pending Reasons",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Terminal job results over the selected range.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
      "id": 15,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true},
      "targets": [{"expr": "sum by (state) (increase(epic_slurm_accounting_jobs_total[$__range]))", "instant": true, "legendFormat": "{{state}}", "refId": "A"}],
      "title": "Selected-range Job Outcomes",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "epic-prometheus"},
      "description": "Prometheus target status. Open Cluster Availability for service and hardware detail.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
      "id": 16,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"expr": "up", "format": "table", "instant": true, "refId": "A"}],
      "title": "Monitoring Target Status",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["epic", "operations", "overview"],
  "templating": {"list": []},
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Cluster Overview",
  "uid": "epic-cluster-overview",
  "version": 1
}
