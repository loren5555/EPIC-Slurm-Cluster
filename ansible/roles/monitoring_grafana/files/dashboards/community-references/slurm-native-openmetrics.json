      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "epic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
