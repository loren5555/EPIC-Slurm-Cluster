# This file is managed by Ansible. Edit inventory variables, not this host copy.

# Cluster identity
ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_controller_host }}

# Authentication and daemon users
AuthType=auth/munge
CredType=cred/munge
SlurmUser=slurm
SlurmdUser=root

# Runtime and persistent state
StateSaveLocation={{ slurm_controller_state_directory }}
SlurmdSpoolDir={{ slurm_compute_spool_directory }}
SlurmctldPidFile=/run/slurmctld/slurmctld.pid
SlurmdPidFile=/run/slurmd/slurmd.pid

# Logging
SlurmctldLogFile={{ slurm_log_directory }}/slurmctld.log
SlurmdLogFile={{ slurm_log_directory }}/slurmd.log
SlurmctldDebug=info
SlurmdDebug=info

# Scheduling and resource selection
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
GresTypes=gpu
MpiDefault=none
ReturnToService=2

# Fair Tree orders queued jobs by decaying historical usage. Job QoS adds a
# bounded priority adjustment and can never preempt a running job.
PriorityType=priority/multifactor
PriorityDecayHalfLife={{ slurm_priority_decay_half_life }}
PriorityCalcPeriod={{ slurm_priority_calculation_period }}
PriorityMaxAge={{ slurm_priority_max_age }}
PriorityWeightFairshare={{ slurm_priority_weight_fairshare }}
PriorityWeightAge={{ slurm_priority_weight_age }}
PriorityWeightJobSize=0
PriorityWeightPartition=0
PriorityWeightQOS={{ slurm_priority_weight_qos }}
PreemptType=preempt/none
PreemptMode=OFF

# Process tracking. Per-host enforcement is defined in cgroup.conf.
ProctrackType=proctrack/cgroup
TaskPlugin=task/affinity,task/cgroup

# Store job records and enforce the declared Associations, limits, and QoS.
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ slurmdbd_host }}
AccountingStorageTRES=gres/gpu
AccountingStorageEnforce={{ slurm_accounting_storage_enforce }}
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=30

# Bounded internal metrics for Prometheus. Historical per-user reporting stays
# in SlurmDBD instead of the high-cardinality jobs-users-accts endpoint.
MetricsType=metrics/openmetrics
MetricsParameters=ignore_private_data

# Compute nodes
{% for node_name in groups['compute_nodes'] | sort %}
{% set node = hostvars[node_name] %}
NodeName={{ node_name }} \
    CPUs={{ node.slurm_cpus }} \
    Boards={{ node.slurm_boards }} \
    SocketsPerBoard={{ node.slurm_sockets_per_board }} \
    CoresPerSocket={{ node.slurm_cores_per_socket }} \
    ThreadsPerCore={{ node.slurm_threads_per_core }} \
    RealMemory={{ node.slurm_real_memory }} \
    Gres=gpu:{{ node.slurm_gpu_count }} \
    State=UNKNOWN
{% endfor %}

# One explicit partition per physical host. No partition is implicit or default.
{% for node_name in groups['compute_nodes'] | sort %}
{% set node = hostvars[node_name] %}
PartitionName={{ node_name }} \
    Nodes={{ node_name }} \
    Default=NO \
    MaxTime={{ slurm_partition_max_time }} \
    TRESBillingWeights="{{ node.slurm_tres_billing_weights }}" \
    State=UP
{% endfor %}
