#!/usr/bin/env python3
"""Export local ext4 quota usage and EPIC policy status for OOD."""

from __future__ import annotations

import json
import os
import pwd
import re
import subprocess
import tempfile
import time
from pathlib import Path


QUOTAS = {{ disk_quotas | to_json }}
HOST = {{ inventory_hostname | to_json }}
OUTPUT = Path({{ ood_quota_directory | to_json }}) / f"{HOST}.json"
WRITER = {{ ood_quota_writer_user | to_json }}


def users_by_uid() -> dict[int, str]:
    return {
        entry.pw_uid: entry.pw_name
        for entry in pwd.getpwall()
        if 10000 <= entry.pw_uid < 20000
    }


def read_usage(filesystem: str) -> dict[str, dict[str, int]]:
    result = subprocess.run(
        ["repquota", "-n", "-p", filesystem],
        check=True,
        text=True,
        capture_output=True,
        env={**os.environ, "LC_ALL": "C"},
    )
    usage: dict[str, dict[str, int]] = {}
    names = users_by_uid()
    for line in result.stdout.splitlines():
        fields = line.split()
        status_index = next(
            (index for index, field in enumerate(fields) if re.fullmatch(r"[-+]{2}", field)),
            None,
        )
        if status_index is None or status_index + 4 >= len(fields):
            continue
        identifier = fields[0].lstrip("#")
        if not identifier.isdigit() or int(identifier) not in names:
            continue
        usage[names[int(identifier)]] = {
            "used": int(fields[status_index + 1]),
            "grace_expires": int(fields[status_index + 4]),
        }
    return usage


def quota_status(used: int, soft: int, hard: int, grace_expires: int, now: int) -> str:
    if hard > 0 and used >= hard:
        return "hard_limit"
    if soft > 0 and used >= soft:
        if grace_expires > 0 and grace_expires <= now:
            return "grace_expired"
        return "soft_limit"
    if soft > 0 and used >= soft * 0.8:
        return "warning"
    return "normal"


def main() -> None:
    rows = []
    timestamp = int(time.time())
    for quota in QUOTAS:
        soft_limit = int(quota["soft_gib"]) * 1024 * 1024
        hard_limit = int(quota["hard_gib"]) * 1024 * 1024
        for user, values in read_usage(quota["filesystem"]).items():
            used = values["used"]
            grace_expires = values["grace_expires"]
            rows.append(
                {
                    "type": "user",
                    "path": quota["filesystem"],
                    "user": user,
                    "total_block_usage": used,
                    "total_file_usage": 0,
                    "block_limit": soft_limit,
                    "file_limit": 0,
                    "timestamp": timestamp,
                    "epic_soft_block_limit": soft_limit,
                    "epic_hard_block_limit": hard_limit,
                    "epic_block_grace_expires": grace_expires,
                    "epic_status": quota_status(
                        used,
                        soft_limit,
                        hard_limit,
                        grace_expires,
                        timestamp,
                    ),
                }
            )

    payload = {
        "version": 1,
        "host": HOST,
        "timestamp": timestamp,
        "quotas": rows,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir="/tmp", delete=False) as handle:
        json.dump(payload, handle, separators=(",", ":"))
        handle.write("\n")
        temporary = Path(handle.name)
    temporary.chmod(0o644)
    remote_temporary = OUTPUT.with_suffix(OUTPUT.suffix + ".tmp")
    try:
        subprocess.run(
            ["runuser", "-u", WRITER, "--", "install", "-m", "0644", str(temporary), str(remote_temporary)],
            check=True,
        )
        subprocess.run(
            ["runuser", "-u", WRITER, "--", "mv", "-f", str(remote_temporary), str(OUTPUT)],
            check=True,
        )
    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
