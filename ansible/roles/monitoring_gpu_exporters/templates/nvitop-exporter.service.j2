# This file is managed by Ansible.
[Unit]
Description=nvitop Prometheus Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=root
Group=root
Slice=system.slice
ExecStart=/opt/nvitop-exporter/bin/nvitop-exporter \
    --bind-address 0.0.0.0 \
    --port {{ monitoring_nvitop_exporter_port }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
