<%
  require 'etc'
  require 'yaml'

  partition_file = '/etc/ood/config/site.d/partitions.yml'
  partitions = File.exist?(partition_file) ? YAML.safe_load(File.read(partition_file)) : {}
  current_user = Etc.getlogin
  partitions.select! { |_name, config| Array(config['allowed_users']).include?(current_user) }

  defaults = { 'cpu_max' => 4, 'gpu_max' => 0, 'gpu_shards_per_gpu' => 0, 'mem_max_gb' => 16 }
  partitions.transform_values! { |config| defaults.merge(config || {}) }

  def yaml_quote(value)
    value.to_s.gsub("'", "''")
  end
%>
---
cluster: epic

form:
  - resource_partition
  - cpus_per_task
  - cpu_oversubscribe
  - gpu_resource
  - memory
  - bc_num_hours
  - working_dir
  - script
  - array
  - auto_accounts
  - extra_sbatch

attributes:
  resource_partition:
    label: Target host
    help: Only hosts available to your Slurm account are listed.
    widget: select
    options:
<% partitions.each do |name, config| %>
<%   cpu_max = config['cpu_max'].to_i %>
<%   memory_max = config['mem_max_gb'].to_i %>
      - - '<%= yaml_quote(config['label'] || name) %>'
        - '<%= yaml_quote(config['partition'] || name) %>'
        - data-label-cpus-per-task: 'CPU cores per task (1-<%= cpu_max %>)'
          data-max-cpus-per-task: <%= cpu_max %>
          data-label-memory: 'Memory per task (GB, 1-<%= memory_max %>)'
          data-max-memory: <%= memory_max %>
<% end %>

  cpus_per_task:
    label: CPU cores per task
    widget: number_field
    value: 4
    min: 1
    max: 128

  cpu_oversubscribe:
    label: Accept shared CPU cores
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    value: 1
    cacheable: false
    help: The job may start sooner, but CPU performance can vary.

  gpu_resource:
    label: GPU resource per task
    widget: select
    value: 'gpu:1'
    cacheable: false
    options:
<% partitions.each_with_index do |(name, config), index| %>
<%   partition = config['partition'] || name %>
<%   gpu_max = config['gpu_max'].to_i %>
<%   shards_per_gpu = config['gpu_shards_per_gpu'].to_i %>
      - - 'No GPU'
        - 'none'
        - data-alias-partition<%= index %>: '<%= yaml_quote(partition) %>'
          data-exclusive-option-for-resource-partition-partition<%= index %>: true
<%   1.upto([shards_per_gpu - 1, 0].max) do |shard_count| %>
      - - 'Shared GPU (<%= shard_count %>/<%= shards_per_gpu %>)'
        - 'shard:<%= shard_count %>'
        - data-exclusive-option-for-resource-partition-partition<%= index %>: true
<%   end %>
<%   1.upto(gpu_max) do |gpu_count| %>
      - - '<%= gpu_count %> full GPU<%= gpu_count == 1 ? "" : "s" %>'
        - 'gpu:<%= gpu_count %>'
        - data-exclusive-option-for-resource-partition-partition<%= index %>: true
<%   end %>
<% end %>

  memory:
    label: Memory per task (GB)
    widget: number_field
    value: 16
    min: 1
    max: 1024

  bc_num_hours:
    label: Runtime (hours, maximum 336h, 14 days)
    widget: number_field
    value: 4
    min: 1
    max: 336

  working_dir:
    label: Working directory on the target host
    widget: text_field
    value: "<%= ENV['HOME'] %>"

  script:
    label: Script path on the target host
    widget: text_field
    required: true

  array:
    label: Job array indexes
    widget: text_field
    value: "1"
    help: Use 1-N or 1-N%P. The array index is passed to the script as --ID.

  extra_sbatch:
    label: Additional sbatch arguments
    widget: text_field
    value: ""
    help: Leave empty unless you know what you are doing.
